[node name="Piso" type="MeshInstance3D" parent="."]
mesh = SubResource("piso")

; La caja: position (1.5, 0.5, 0), rotada 30° en Y, escala (1, 1.5, 1).
; Todo eso es UN Transform3D. Compáralo con la matemática a mano del módulo 6:
; aquí el motor arma y multiplica la matriz por ti.
[node name="Caja" type="MeshInstance3D" parent="."]
transform = Transform3D(0.866, 0, -0.5, 0, 1.5, 0, 0.5, 0, 0.866, 1.5, 0.5, 0)
mesh = SubResource("caja")
