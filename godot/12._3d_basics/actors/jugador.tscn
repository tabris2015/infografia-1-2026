[gd_scene load_steps=6 format=3 uid="uid://b3d12jugador"]

; Jugador reusable: una bola RigidBody3D con su forma de choque y su malla.
; Se instancia en las escenas 09 y 10. Mueve con scripts/jugador.gd.

[ext_resource type="Script" path="res://scripts/jugador.gd" id="1"]

[sub_resource type="PhysicsMaterial" id="fis"]
friction = 0.8
bounce = 0.1

[sub_resource type="SphereShape3D" id="forma"]
radius = 0.5

[sub_resource type="StandardMaterial3D" id="mat"]
albedo_color = Color(0.95, 0.5, 0.2, 1)
roughness = 0.4
metallic = 0.2

[sub_resource type="SphereMesh" id="malla"]
material = SubResource("mat")
radius = 0.5
height = 1.0

[node name="Jugador" type="RigidBody3D"]
physics_material_override = SubResource("fis")
script = ExtResource("1")

[node name="Forma" type="CollisionShape3D" parent="."]
